{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gauntlet program",
  "type": "object",
  "required": ["version", "plan_version", "goal", "execution", "budget", "workstreams", "verification_panel"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "plan_version": {"type": "integer", "minimum": 1},
    "goal": {"type": "string", "minLength": 1},
    "execution": {
      "type": "object",
      "required": ["explicitly_invoked", "fresh_judges", "builder_can_issue_final_verdict", "write_isolation"],
      "properties": {
        "explicitly_invoked": {"const": true},
        "fresh_judges": {"const": true},
        "builder_can_issue_final_verdict": {"const": false},
        "write_isolation": {"enum": ["disjoint_targets", "separate_worktrees", "serialized"]}
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_elapsed_minutes", "max_agent_launches", "max_concurrency", "max_critic_rounds_per_workstream"],
      "properties": {
        "max_elapsed_minutes": {"type": "integer", "minimum": 1},
        "max_agent_launches": {"type": "integer", "minimum": 1},
        "max_concurrency": {"type": "integer", "minimum": 1},
        "max_critic_rounds_per_workstream": {"type": "integer", "minimum": 1}
      }
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "objective",
          "dependencies",
          "write_targets",
          "acceptance_criteria",
          "evidence_required",
          "builder_charter",
          "critic_charter",
          "critic",
          "max_critic_rounds",
          "stop_conditions"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "write_targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "acceptance_criteria": {"type": "array", "minItems": 1},
          "evidence_required": {"type": "array", "minItems": 1},
          "builder_charter": {"type": "string", "minLength": 1},
          "critic_charter": {"type": "string", "minLength": 1},
          "critic": {"type": "string", "minLength": 1},
          "max_critic_rounds": {"type": "integer", "minimum": 1},
          "stop_conditions": {"type": "array", "minItems": 1}
        }
      }
    },
    "integration_waves": {"type": "array", "minItems": 1},
    "verification_panel": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
